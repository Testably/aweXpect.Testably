<Project>

	<Import Project="$(MSBuildThisFileDirectory)/../../Directory.Build.props"
			Condition="Exists('$(MSBuildThisFileDirectory)/../../Directory.Build.props')"/>

	<!--
	    The smoke tests are console applications published with Native AOT, so that every expectation is exercised
	    the way a consumer's trimmed application exercises it. They report their result through the exit code, so
	    they need no test framework.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<!--
	    A warning from the trimmer or the AOT compiler means that code the expectations rely on may not survive
	    trimming, so it fails the publish, and the site is named instead of being rolled up per assembly.
	-->
	<PropertyGroup>
		<ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>
		<SonarQubeExclude>true</SonarQubeExclude>
		<SignAssembly>False</SignAssembly>
	</PropertyGroup>

</Project>
